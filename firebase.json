{
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-functions-test"
            ]
        }
    ],
    "hosting": {
        "public": "client/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
        "node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "function": "api",
                "region": "us-central1"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
